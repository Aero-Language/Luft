module AeroTests.ComplexTest {
    // Generic trait with multiple methods
    public trait IComparable<T, TReturn> {
        fun CompareTo(other: T) -> TReturn
        fun Equals(other: T) -> Bool
    }

    public trait IPrintable {
        fun ToString() -> String
    }

    // Generic struct implementing multiple traits
    public struct Vector2<T> : IComparable<Vector2<T>, Int>, IPrintable {
        var X: T
        var Y: T

        public impl fun CompareTo(other: Vector2<T>) -> Int {
            0
        }

        public impl fun Equals(other: Vector2<T>) -> Bool {
            true
        }

        public impl fun ToString() -> String {
            "Vector"
        }
    }

    public struct IntVec2 : Vector2<Int> {
        public impl fun CompareTo(other: IntVec2) -> Int {
            
        }
        
        public impl fun Equals(other: IntVec2) -> Bool {
            self.X == other.X && self.Y == other.Y
        }
    }

    // Generic class with primary constructor and generics
    public class Container<G> {
        public Items: G[] {
            get => it
            set => it = value
        }

        public constructor Container(initial: G[]) {
            Items = initial
        }

        // Method overloading
        public fun Get(index: Int) -> G {
            Items[index]
        }

        public fun Get() -> G {
            Items[0]
        }

        // Generic method
        public fun Map<U>(transform: (item: G) -> U) -> U[] {
            []
        }
    }

    // Extension function on generic type
    public extension fun Container<Int>.Sum() -> Int {
        var total: Int = 0
        for (item in self.Items) {
            total += item
        }
        return total
    }

    // Record with generics
    public record Pair<A, B> {
        public val First: A
        public val Second: B
    }

    // Class with property accessors
    public class Person(age: Int) {
        private var _age: Int = age // You can also declare backing properties yourself instead of using the 'it' keyword in a property, but it is discouraged as it is unnecessary and makes the code less readable

        public Age: Int {
            get => _age
            set => _age = value
        }
    }

    // Virtual and sealed methods
    public class Animal {
        public virtual fun Speak() -> String {
            "Generic sound"
        }

        public fun Move() -> Bool {
            true
        }
    }

    public class Dog : Animal {
        public impl fun Speak() -> String {
            "Woof"
        }
    }

    // Enum
    public enum Result {
        Success,
        Failure,
        Pending
    }

    public struct Optional<G>(value: G?, result: Result) {
        public val Value: G? = value
        public val Result: Result = result
        
        public static fun WithValue(value: G) -> Optional<G> {
            Optional<G>(value, AeroTests.ComplexTest.Result.Success)
        }
        
        public static fun Empty() -> Optional<G> {
            Optional<G>(null, AeroTests.ComplexTest.Result.Failure)
        }
        
        public IsDone: Bool { get => Result is Result.Success }
    }

    // Extensions block
    public extensions Int {
        public fun IsEven() -> Bool {
            (self % 2) == 0
        }

        public fun IsOdd() -> Bool {
            (self % 2) != 0
        }
    }

    // Operator overloading
    public class Complex {
        public val Real: Float
        public val Imaginary: Float

        public constructor Complex(r: Float, i: Float) {
            Real = r
            Imaginary = i
        }

        public operator fun Add(other: Complex) -> Complex {
            Complex(Real + other.Real, Imaginary + other.Imaginary)
        }

        public operator fun Multiply(scalar: Float) -> Complex {
            Complex(Real * scalar, Imaginary * scalar)
        }
    }

    // Pattern matching with complex types
    public fun ProcessResult(result: Result) -> String {
        match (result) {
            Result.Success => "Success",
            Result.Failure => "Failed",
            Result.Pending => "In progress",
            else => "Unknown"
        }
    }

    // Lambda and higher-order functions
    public fun Filter<T>(items: T[], predicate: (item: T) -> Bool) -> T[] {
        []
    }

    // While loop with state
    public fun Countdown(start: Int) -> Int {
        var counter: Int = start
        while (counter > 0) {
            counter -= 1
        }
        return counter
    }

    // Nested generics and complex expressions
    public fun CreatePair<X, Y>(first: X, second: Y) -> Pair<X, Y> {
        Pair<X, Y>(first, second)
    }

    // Range expressions
    public fun SumRange(start: Int, end: Int) -> Int {
        var sum: Int = 0
        for (i in start..end) {
            sum += i
        }
        return sum
    }

    // String interpolation with expressions
    public fun FormatPerson(person: Person) -> String {
        val age: Int = person.Age
        return $"Person aged {age}"
    }

    // Method overloading with different arities
    public fun Calculate(a: Int, b: Int) -> Int {
        a + b
    }

    public fun Calculate(a: Int) -> Int {
        a * 2
    }

    // Main function exercising all features
    public fun main(args: String[]) -> Int {
        // Test generic struct
        val vec: Vector2<Int> = Vector2<Int>()

        // Test generic class
        val container: Container<Int> = Container<Int>([1, 2, 3, 4, 5])
        val sum: Int = container.Sum()

        // Test extensions
        val isEven: Bool = 4.IsEven()
        val isOdd: Bool = 5.IsOdd()

        // Test operator overloading
        val c1: Complex = Complex(1.0, 2.0)
        val c2: Complex = Complex(3.0, 4.0)
        val c3: Complex = c1 + c2

        // Test pattern matching
        val resultStatus: String = ProcessResult(Result.Success)

        // Test class hierarchy and virtual methods
        val dog: Dog = Dog()
        val sound: String = dog.Speak()

        // Test person with property accessors
        val person: Person = Person(25)
        person.Age = 30
        val formatted: String = FormatPerson(person)

        // Test range loops
        val rangeSum: Int = SumRange(1, 10)

        // Test method overloading
        val calc1: Int = Calculate(5, 3)
        val calc2: Int = Calculate(5)

        // Test generic pair creation
        val pair: Pair<String, Int> = CreatePair<String, Int>("test", 42)

        // Test filter with lambda
        val nums: Int[] = [1, 2, 3, 4, 5]
        val filtered: Int[] = Filter(nums) { n: Int -> n > 2 }

        // Test countdown loop
        val countdown: Int = Countdown(5)

        return 0
    }
}